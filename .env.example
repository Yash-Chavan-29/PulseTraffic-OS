# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (CORS)
CLIENT_URL=http://localhost:5173

# Simulation Toggles
SIMULATE_CONGESTION=true
AI_FORECAST_WINDOW_MIN=30

# Python FastAPI Adaptive Signal Optimization System
TRAFFIC_API_PORT=8000
TRAFFIC_DB_PATH=traffic_optimization.db

# Real-World Hardware Safety Controls (Default: false for simulation)
ALLOW_HARDWARE_OVERRIDE=false
HARDWARE_AUTH_KEY=LAB_PROTOTYPE_DEMO_KEY
HARDWARE_SERIAL_PORT=COM3
HARDWARE_BAUD_RATE=115200

# MQTT Telemetry Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

